local function getValidTargets()
    local targets = {}
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= player then
            local char = plr.Character
            if char and char:FindFirstChild("Humanoid") and char.Humanoid.Health > 0 then
                local root = char:FindFirstChild("HumanoidRootPart")
                if root then
                    table.insert(targets, root)
                end
            end
        end
    end
    return targets
end

local function getClosestTarget()
    local rootPos = camera.CFrame.Position
    local closest = nil
    local closestDist = aimRadius
    for _, targetPart in ipairs(getValidTargets()) do
        local dist = (targetPart.Position - rootPos).Magnitude
        if dist < closestDist then
            closestDist = dist
            closest = targetPart
        end
    end
    return closest
end

local function aimAtTarget(targetPart)
    if not targetPart then return end
    local targetPos = targetPart.Position + Vector3.new(0, 1.5, 0)
    local currentCF = camera.CFrame
    local lookAt = CFrame.lookAt(currentCF.Position, targetPos)
    local newCF = currentCF:Lerp(lookAt, smoothness)
    camera.CFrame = newCF
end

local function toggleAim()
    aimEnabled = not aimEnabled
    if aimEnabled then
        toggleBtn.Text = "🔥 AUTO AIM: ON 🔥"
        toggleBtn.BackgroundColor3 = Color3.fromRGB(0, 80, 0)
        toggleBtn.TextColor3 = Color3.fromRGB(150, 255, 150)
    else
        toggleBtn.Text = "AUTO AIM: OFF"
        toggleBtn.BackgroundColor3 = Color3.fromRGB(100, 0, 0)
        toggleBtn.TextColor3 = Color3.fromRGB(255, 200, 200)
        target = nil
    end
end

local function setRange(newRange)
    aimRadius = math.clamp(newRange, 10, 500)
    rangeLabel.Text = "📏 Range: " .. tostring(aimRadius)
    rangeInput.Text = tostring(aimRadius)
end

toggleBtn.MouseButton1Click:Connect(toggleAim)

rangeDec.MouseButton1Click:Connect(function() setRange(aimRadius - 10) end)
rangeInc.MouseButton1Click:Connect(function() setRange(aimRadius + 10) end)

rangeInput.FocusLost:Connect(function()
    local val = tonumber(rangeInput.Text)
    if val and val > 0 then
        setRange(val)
    else
        rangeInput.Text = tostring(aimRadius)
    end
end)

UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.KeyCode == Enum.KeyCode.X then
        toggleAim()
    end
end)

RunService.Heartbeat:Connect(function()
    if not aimEnabled then return end
    target = getClosestTarget()
    if target then
        aimAtTarget(target)
    end
end)

player.CharacterAdded:Connect(function()
    if aimEnabled then
        aimEnabled = false
        toggleBtn.Text = "AUTO AIM: OFF"
        toggleBtn.BackgroundColor3 = Color3.fromRGB(100, 0, 0)
        toggleBtn.TextColor3 = Color3.fromRGB(255, 200, 200)
    end
end)
